# Copie este arquivo para .env. Nunca publique o .env.
# Use uma NOVA chave; a chave compartilhada na conversa deve ser revogada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Escolha um token com 24 ou mais caracteres; ele será informado no app.
LOCAL_API_TOKEN=
PORT=8787
# Para celular físico na mesma rede, altere para 0.0.0.0.
HOST=127.0.0.1
# Flutter Web usa a porta fixa 5173 nos comandos do README.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
